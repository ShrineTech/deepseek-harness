#!/bin/bash
# Run the dsh CLI from an installed source tree inside a Docker box with NO network
# (--network none: loopback only). The one way out is a unix socket relayed to ONE
# host port (the local llama-server). Every connect() and send*() of the dsh process
# tree is logged with strace.
#   dsh-box <dsh-src> <scratch> [dsh args...]
#     <dsh-src>   built checkout (pnpm install + host libs built: apps/cli/lib/bin.js; read-only in the box)
#     <scratch>   work dir: home/, dsh-home/, repo/ live here (the only writable mount)
# Env: FORGE_LLAMA_PORT (8097), FORGE_LLAMA_MODEL, FORGE_LLAMA_CTX, FORGE_LLAMA_MAX_TOKENS,
#      FORGE_LLAMA_UPSTREAM_PORT (host port the relay dials; default FORGE_LLAMA_PORT, e.g. a logging proxy),
#      DSH_BOX_CWD (<scratch>/repo), DSH_BOX_STRACE (<scratch>/strace-connect.log), DSH_BOX_CPUS (4),
#      DSH_BOX_ENTRY (JS entry inside <dsh-src>; default apps/cli/lib/bin.js. The Sando head-to-head runs
#      Sando's release bin/zcode.mjs in the same box), DSH_BOX_PASSENV (names of extra env vars to pass in),
#      DSH_BOX_IMAGE (shrinetech-dsh-box:0.2 = egress-lab Ubuntu 24.04 + strace + musl-tools + ripgrep + git, built from
#      box-image/; 0.1 = the same without ripgrep/git, used by the 2026-11-17 head-to-head).
# Why Docker and not bwrap/systemd: on this host bwrap cannot bring up loopback in an
# unprivileged netns (apparmor_restrict_unprivileged_userns=1), and systemd USER units
# do not enforce IPAddressDeny (both tested 2026-11-17).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
src=$(realpath "$1"); scratch=$(realpath "$2"); shift 2
port=${FORGE_LLAMA_PORT:-8097}
upstream=${FORGE_LLAMA_UPSTREAM_PORT:-$port}
entry=${DSH_BOX_ENTRY:-apps/cli/lib/bin.js}
cwd=${DSH_BOX_CWD:-$scratch/repo}
trace=${DSH_BOX_STRACE:-$scratch/strace-connect.log}
node_root=$(dirname "$(dirname "$(readlink -f "$(command -v node)")")")
mkdir -p "$scratch/home" "$scratch/dsh-home" "$scratch/run" "$cwd"
cp "$here/cordis.patch.yml" "$scratch/dsh-home/cordis.patch.yml"
cp "$here/relay.mjs" "$scratch/run/relay.mjs"
sock=$scratch/run/llama.sock

node "$scratch/run/relay.mjs" out "$sock" "$upstream" & relay=$!
trap 'kill $relay 2>/dev/null' EXIT
for _ in $(seq 50); do [ -S "$sock" ] && break; sleep 0.1; done

# Telemetry / update / crash switches (study §1 step 2, plus chrome-devtools-mcp's opt-out).
envs=(
  -e HOME="$scratch/home" -e DSH_HOME="$scratch/dsh-home"
  -e PATH="/opt/node/bin:/usr/bin:/bin" -e LANG=C.UTF-8 -e TERM=dumb
  -e DSH_TELEMETRY_DISABLED=1 -e DSH_TELEMETRY_MODE=DISABLED
  -e DSH_TELEMETRY_OTLP_URL=http://127.0.0.1:9/v1/logs
  -e DSH_PRODUCT_ANALYTICS_OTLP_URL=http://127.0.0.1:9/v1/logs
  -e CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1 -e NO_UPDATE_NOTIFIER=1 -e DO_NOT_TRACK=1
  -e FORGE_LLAMA_PORT="$port" -e FORGE_LLAMA_API_KEY=local-no-key
)
[ -n "${FORGE_LLAMA_MODEL:-}" ] && envs+=(-e FORGE_LLAMA_MODEL="$FORGE_LLAMA_MODEL")
[ -n "${FORGE_LLAMA_CTX:-}" ] && envs+=(-e FORGE_LLAMA_CTX="$FORGE_LLAMA_CTX")
[ -n "${FORGE_LLAMA_MAX_TOKENS:-}" ] && envs+=(-e FORGE_LLAMA_MAX_TOKENS="$FORGE_LLAMA_MAX_TOKENS")
for v in ${DSH_BOX_PASSENV:-}; do envs+=(-e "$v=${!v}"); done

# Read-only image root, no capabilities, our uid; mounts: node (ro), dsh tree (ro), scratch (rw).
docker run --rm -i --init --network none --cpus "${DSH_BOX_CPUS:-4}" --memory 8g --pids-limit 1024 \
  --user "$(id -u):$(id -g)" --cap-drop ALL --security-opt no-new-privileges \
  --read-only --tmpfs /tmp:rw,exec,size=512m \
  -v "$node_root:/opt/node:ro" -v "$src:$src:ro" -v "$scratch:$scratch" \
  -w "$cwd" "${envs[@]}" --entrypoint /bin/bash "${DSH_BOX_IMAGE:-shrinetech-dsh-box:0.2}" -c '
    node "$1/run/relay.mjs" in "$1/run/llama.sock" "$FORGE_LLAMA_PORT" & relay=$!; sleep 0.3
    src=$2; trace=$3; entry=$4; shift 4
    strace -f -qq -e trace=connect,sendto,sendmsg,sendmmsg -o "$trace" \
      node "$src/$entry" "$@"
    rc=$?; kill $relay; exit $rc
  ' dsh-box "$scratch" "$src" "$trace" "$entry" "$@"
